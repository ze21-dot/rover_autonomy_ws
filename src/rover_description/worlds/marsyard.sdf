          <geometry><mesh><uri>model://rover_description/worlds/materials/marsyard_collision.stl</uri></mesh></geometry>
          <surface><friction><ode><mu>1.1</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><mesh><uri>model://rover_description/worlds/materials/marsyard_terrain.obj</uri></mesh></geometry>
        </visual>
      </link></model>

