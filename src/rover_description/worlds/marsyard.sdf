<?xml version="1.0"?>
<!-- Mars-yard v4: crater/ridge/slope topography, irregular rocks, sunset light, tiled sand. -->
<sdf version="1.8">
  <world name="marsyard">
    <physics name="default" type="dartsim"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.34 0.28 0.24 1</ambient>
      <background>0.82 0.58 0.42 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 14 0 0 0</pose>
      <direction>-0.65 0.18 -0.32</direction>
      <diffuse>1.0 0.84 0.66 1</diffuse>
      <specular>0.35 0.3 0.25 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="terrain"><static>true</static>
      <link name="t">
