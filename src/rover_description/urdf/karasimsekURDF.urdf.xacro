<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="karasimsek_base">

  <xacro:property name="effort_limit"        value="10000"/>

  <!-- Rocker + chassis-tilt limits (about +Y) -->
  <xacro:property name="rocker_lower"        value="-0.5"/>
  <xacro:property name="rocker_upper"        value="0.5"/>
  <xacro:property name="rocker_velocity"     value="2.0"/>

  <!-- Steering limits (about +Z) -->
  <xacro:property name="steer_lower"         value="-1.57"/>
  <xacro:property name="steer_upper"         value="1.57"/>
  <xacro:property name="steer_velocity"      value="2.0"/>

  <!-- Wheel spin limits (about +Y) -->
  <xacro:property name="wheel_velocity"      value="28.0"/>
  <xacro:arg name="diff_joints" default="fixed"/>
  <xacro:property name="diff_activation"    value="$(arg diff_joints)"/> <!--set 'revolute' to enable differential bar motion -->

  <!-- If your chassis_link origin is not at ground, set this to the height offset -->
  <xacro:property name="base_footprint_z"    value="0.391175"/>


  <link name="base_footprint"/>

  <link name="suspension_frame">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- REP-103/105 root: base_footprint -> base_link (x-forward) -> suspension_frame -->
  <!-- Mechanical model is Y-forward (SolidWorks export); the -90deg yaw below makes
       base_link x-forward per REP-103 without touching any baked-in coordinates. -->
  <link name="base_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 ${base_footprint_z}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <joint name="suspension_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 -1.5707963"/>
    <parent link="base_link"/>
    <child link="suspension_frame"/>
  </joint>


  <link name="chassis_link">
    <inertial>
      <origin xyz="0.011561 -0.031261 0.11152" rpy="0 0 0"/>
      <mass value="41.71"/>
      <inertia ixx="1.786883" ixy="-0.000430" ixz="0.000008"
               iyy="0.962913" iyz="-0.024260"  izz="2.494222"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.069175" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/Chassis_link.STL"/>
      </geometry>
      <material name="carbon_dark"><color rgba="0.13 0.13 0.15 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 -0.07 0.2295" rpy="0 0 0"/>
      <geometry>
        <box size="0.74 1.104 0.597"/>
      </geometry>
    </collision>
  </link>

  <joint name="chassis_tilt_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="suspension_frame"/>
    <child link="chassis_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${rocker_lower}" upper="${rocker_upper}" effort="${effort_limit}" velocity="${rocker_velocity}"/>
  </joint>


  <link name="left_link">
    <inertial>
      <origin xyz="-0.00209802718767052 -2.11363326615699E-05 0.00412803549202381" rpy="0 0 0"/>
      <mass value="1.38941165084486"/>
      <inertia ixx="0.00293063634186868" ixy="-4.56151449981984E-07" ixz="-6.84326185465972E-07"
               iyy="0.000848151587940606" iyz="1.23176386433909E-05"  izz="0.00298318680683064"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/left_link.STL"/>
      </geometry>
      <material name="gunmetal"><color rgba="0.28 0.29 0.32 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.003 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="0.163 1.016 0.184"/>
      </geometry>
    </collision>
  </link>

  <!-- CHANGED: parent is suspension_frame; axis is +Y -->
  <joint name="leftjoint" type="${diff_activation}">
    <origin xyz="-0.37 -0.0002267 0.0" rpy="0 0 0"/>
    <parent link="suspension_frame"/>
    <child link="left_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${rocker_lower}" upper="${rocker_upper}" effort="${effort_limit}" velocity="${rocker_velocity}"/>
  </joint>


  <link name="FLSteer_Link">
    <inertial>
      <origin xyz="0.0377009321853812 -0.00024602714017008 -0.30836689271485" rpy="0 0 0"/>
      <mass value="0.71518654251353"/>
      <inertia ixx="0.00169374591110814" ixy="5.88425051840532E-06" ixz="0.000464138610212657"
               iyy="0.00198531464810737" iyz="-2.66551043226187E-06" izz="0.000826238221543173"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/FLSteer_Link.STL"/>
      </geometry>
      <material name="alu_bright"><color rgba="0.78 0.79 0.81 1"/></material>
    </visual>
  </link>

  <!-- Steering about +Z -->
  <joint name="FLSteerJoint" type="revolute">
    <dynamics damping="0.8" friction="0.3"/>
    <origin xyz="0.007701 0.44172 0.10018" rpy="0 0 0"/>
    <parent link="left_link"/>
    <child link="FLSteer_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${steer_lower}" upper="${steer_upper}" effort="${effort_limit}" velocity="${steer_velocity}"/>
  </joint>

  <link name="FLWheel_Link">
    <inertial>
      <origin xyz="0.0521033432270625 -1.68747926743151E-09 -6.76693881485058E-10" rpy="0 0 0"/>
      <mass value="2.83948168838862"/>
      <inertia ixx="0.0328805710292491" ixy="4.96576460716099E-11" ixz="1.94196556073825E-11"
               iyy="0.0186794092902404" iyz="2.0038607466756E-10" izz="0.0186794088707135"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/FLWheel_Link.STL"/>
      </geometry>
      <material name="tire_black"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.1465" length="0.11"/>
      </geometry>
    </collision>
  </link>

  <!-- CHANGED: wheel spin axis is +Y -->
  <joint name="FLWheelJoint" type="continuous">
    <dynamics damping="0.05" friction="0.05"/>
    <origin xyz="-0.054895 -0.00056736 -0.34115" rpy="0 0 0"/>
    <parent link="FLSteer_Link"/>
    <child link="FLWheel_Link"/>
    <axis xyz="-1 0 0"/>
    <limit effort="${effort_limit}" velocity="${wheel_velocity}"/>
  </joint>


  <link name="RLSteer_Link">
    <inertial>
      <origin xyz="0.037695892067576 -0.000252024365467285 -0.308366865117997" rpy="0 0 0"/>
      <mass value="0.715186545102284"/>
      <inertia ixx="0.0016937459127041" ixy="5.88425049213231E-06" ixz="0.000464138610194234"
               iyy="0.00198531464860305" iyz="-2.66551118046577E-06" izz="0.000826238222648132"/>
    </inertial>
    <visual>
