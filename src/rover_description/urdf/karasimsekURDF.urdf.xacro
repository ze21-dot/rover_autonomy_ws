      <geometry>
        <box size="0.163 1.016 0.184"/>
      </geometry>
    </collision>
  </link>

  <!-- CHANGED: parent is suspension_frame; axis is +Y -->
  <joint name="rightjoint" type="${diff_activation}">
    <origin xyz="0.37 -0.0002267 0.0" rpy="0 0 0"/>
    <parent link="suspension_frame"/>
    <child link="right_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="${rocker_lower}" upper="${rocker_upper}" effort="${effort_limit}" velocity="${rocker_velocity}"/>
