      </geometry>
      <material name="alu_bright"><color rgba="0.78 0.79 0.81 1"/></material>
    </visual>
  </link>

  <!-- Steering about +Z -->
  <joint name="RLSteerJoint" type="revolute">
    <dynamics damping="0.8" friction="0.3"/>
    <origin xyz="0.0072079 -0.44077 0.10018" rpy="0 0 0"/>
    <parent link="left_link"/>
    <child link="RLSteer_Link"/>
    <axis xyz="0 0 1"/>
    <limit lower="${steer_lower}" upper="${steer_upper}" effort="${effort_limit}" velocity="${steer_velocity}"/>
  </joint>

  <link name="RLWheel_Link">
    <inertial>
      <origin xyz="0.052103343226429 -1.6874807662326E-09 -6.77053871300792E-10" rpy="0 0 0"/>
      <mass value="2.83948168838861"/>
      <inertia ixx="0.0328805710292489" ixy="4.96576718367571E-11" ixz="1.94197268304237E-11"
               iyy="0.0186794092902404" iyz="2.00386049574616E-10" izz="0.0186794088707134"/>
