  <joint name="SecondBallJoint" type="fixed">
    <origin xyz="0.014053 -0.17642 -0.011676" rpy="0 0 0"/>
    <parent link="LeftRod_Link"/>
    <child link="SecondBall_Link"/>
  </joint>

  <link name="right_link">
    <inertial>
      <origin xyz="0.00209802718465879 2.18976423624687E-05 0.00412803152925648" rpy="0 0 0"/>
      <mass value="1.38941165065011"/>
      <inertia ixx="0.00293063634164709" ixy="-4.56025386556254E-07" ixz="6.84410257330667E-07"
               iyy="0.000848147117618743" iyz="-1.1923930426203E-05"  izz="0.00298319127672637"/>
    </inertial>
    <visual>
