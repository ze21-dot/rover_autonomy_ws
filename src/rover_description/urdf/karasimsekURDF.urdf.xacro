  </link>

  <!-- CHANGED: wheel spin axis is +Y -->
  <joint name="RLWheelJoint" type="continuous">
    <dynamics damping="0.05" friction="0.05"/>
    <origin xyz="-0.0549 -0.00057336 -0.34115" rpy="0 0 0"/>
